local function setMinimized(state)

	minimized = state

	animateMinimizeIcon()

	if minimized then

		content.Visible = false
		targetMenu.Visible = false

		TweenService:Create(
			frame,
			TweenInfo.new(
				0.25,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),
			{
				Size = UDim2.fromOffset(300, 42)
			}
		):Play()

	else

		local tween = TweenService:Create(
			frame,
			TweenInfo.new(
