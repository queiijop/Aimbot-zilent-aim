--------------------------------------------------
-- SET TARGET
--------------------------------------------------

local function setTarget(player)

	if not player then

		lockedPlayer = nil
		currentIndex = 0

		removeTargetHighlight()
		updateTargetDisplay()

		return
	end

	lockedPlayer = player

	local list = getTargetList()

	for i, playerInList in ipairs(list) do

		if playerInList == player then
			currentIndex = i
			break
		end

	end

	updateTargetDisplay()
	updateTargetHighlight()
end

--------------------------------------------------
-- FIND NEXT VALID TARGET
--------------------------------------------------

local function findNextAcceptedTarget(direction)

	local list = getTargetList()

	if #list == 0 then
		return nil
	end

	if not lockedPlayer then
		return list[1]
	end

	local index = 0

	for i, player in ipairs(list) do

		if player == lockedPlayer then
			index = i
			break
		end

	end

	if index == 0 then
		return list[1]
	end

	index += direction

	if index > #list then
		index = 1
	elseif index < 1 then
		index = #list
	end

	return list[index]
end

