local function setSilentAimFOVFromX(x)
    if not content.Visible then return end
    local width = silentAimFOVBar.AbsoluteSize.X
    if width <= 0 then return end
    local relative = math.clamp((x - silentAimFOVBar.AbsolutePosition.X) / width, 0, 1)
    silentAimFOV = math.floor(relative * 360 + 0.5)
    silentAimFOVLabel.Text = "SILENT AIM FOV: " .. tostring(silentAimFOV)
    silentAimFOVFill.Size = UDim2.new(silentAimFOV / 360, 0, 1, 0)
    silentAimFOVKnob.Position = UDim2.new(silentAimFOV / 360, 0, 0.5, 0)
    fovCircle.Size = UDim2.fromOffset(silentAimFOV * 2, silentAimFOV * 2)
end

silentAimFOVBar.InputBegan:Connect(function(input)
    if not content.Visible then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        silentAimFOVDragging = true
        setSilentAimFOVFromX(input.Position.X)
    elseif input.UserInputType == Enum.UserInputType.Touch then
        silentAimFOVDragging = true
        silentAimTouch = input
        setSilentAimFOVFromX(input.Position.X)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not silentAimFOVDragging or not content.Visible then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        setSilentAimFOVFromX(input.Position.X)
    elseif input.UserInputType == Enum.UserInputType.Touch and input == silentAimTouch then
        setSilentAimFOVFromX(input.Position.X)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        silentAimFOVDragging = false
    elseif input.UserInputType == Enum.UserInputType.Touch and input == silentAimTouch then
        silentAimFOVDragging = false
        silentAimTouch = nil
    end
end)

