-- MINIMIZE ICON ANIMATION
--------------------------------------------------

local function animateMinimizeIcon()

	local white =
		Color3.fromRGB(255, 255, 255)

	local rgb =
		Color3.fromHSV(
			math.random(),
			0.55,
			0.9
		)

	local fadeIn = TweenInfo.new(
		0.15,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.Out
	)

	local fadeOut = TweenInfo.new(
		0.15,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.Out
	)

	TweenService:Create(
		miniHorizontal,
		fadeIn,
		{
			BackgroundColor3 = rgb
		}
	):Play()

	TweenService:Create(
		miniVertical,
		fadeIn,
		{
			BackgroundColor3 = rgb
		}
	):Play()

	task.delay(0.15, function()

		TweenService:Create(
			miniHorizontal,
			fadeOut,
			{
				BackgroundColor3 = white
			}
		):Play()

		TweenService:Create(
			miniVertical,
			fadeOut,
			{
				BackgroundColor3 = white
			}
		):Play()

	end)

	minimizeButton.Rotation = 0

	local rotationTween = TweenService:Create(
		minimizeButton,
		TweenInfo.new(
			0.5,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			Rotation = 360
		}
	)

	rotationTween:Play()

	rotationTween.Completed:Connect(function()

		minimizeButton.Rotation = 0

	end)

end

