--------------------------------------------------
-- PLAYER IS ALIVE
--------------------------------------------------

local function isPlayerAlive(player)

	if not player then
		return false
	end

	if deadPlayers[player] then
		return false
	end

	local character = player.Character

	if not character then
		return false
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return false
	end

	return humanoid.Health > 0
end

--------------------------------------------------
-- TARGET LIST
--------------------------------------------------

local function getTargetList()

	local list = {}

	for _, player in ipairs(Players:GetPlayers()) do

		if player ~= localPlayer then

			if acceptedMode then

				if acceptedPlayers[player]
					and isPlayerAlive(player) then

					table.insert(list, player)
				end

			else

				table.insert(list, player)

			end
		end
	end

	table.sort(list, function(a, b)
		return a.Name:lower() < b.Name:lower()
	end)

	return list
end

--------------------------------------------------
-- CLOSEST ACCEPTED TARGET
--------------------------------------------------

local function getClosestAcceptedTarget()
	if not acceptedMode then
		return nil
	end

	-- Find the accepted player who is physically closest
	-- to the local player's character. This does not depend
	-- on the mouse/crosshair position or whether they are
	-- currently on screen.
	local localCharacter = localPlayer.Character
	if not localCharacter then
		return nil
	end

	local localRoot =
		localCharacter:FindFirstChild("HumanoidRootPart")

	if not localRoot then
		return nil
	end

	local closestPlayer = nil
	local closestDistance = math.huge

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer
			and acceptedPlayers[player]
			and not deadPlayers[player] then

			local character = player.Character
			local humanoid = character
				and character:FindFirstChildOfClass("Humanoid")

			local targetRoot = character
				and character:FindFirstChild("HumanoidRootPart")

			if humanoid
				and humanoid.Health > 5
				and targetRoot then

				local distance =
					(localRoot.Position - targetRoot.Position).Magnitude

				if distance < closestDistance then
					closestDistance = distance
					closestPlayer = player
				end
			end
		end
	end

	return closestPlayer
end

--------------------------------------------------
-- SILENT AIM TARGET SELECTOR
--------------------------------------------------

-- Returns the closest valid target to the center of the screen
-- inside the configured FOV. Your weapon/firing code can call
-- this through the BindableFunction below.
local function getSilentAimTarget()
    if not silentAimEnabled then
        return nil
    end

    local camera = workspace.CurrentCamera
    if not camera then return nil end

    local center = Vector2.new(
        camera.ViewportSize.X * 0.5,
        camera.ViewportSize.Y * 0.5
    )

    local closestPlayer = nil
    local closestDistance = silentAimFOV

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer
            and acceptedPlayers[player]
            and not deadPlayers[player] then

            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local root = character and character:FindFirstChild("HumanoidRootPart")

            if humanoid and humanoid.Health > 5 and root then
                local screenPosition, onScreen = camera:WorldToViewportPoint(root.Position)

                if onScreen then
                    local distance = (Vector2.new(screenPosition.X, screenPosition.Y) - center).Magnitude

                    if distance <= closestDistance then
                        closestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end

    return closestPlayer
end

