--------------------------------------------------
-- CYCLE TARGET
--------------------------------------------------

local function cycleTarget(direction)

	local list = getTargetList()

	if #list == 0 then

		lockedPlayer = nil
		currentIndex = 0

		removeTargetHighlight()
		updateTargetDisplay()

		return
	end

	if currentIndex < 1
		or currentIndex > #list then

		currentIndex = 0

		if lockedPlayer then

			for i, player in ipairs(list) do

				if player == lockedPlayer then
					currentIndex = i
					break
				end

			end
		end

		if currentIndex == 0 then

			if direction > 0 then
				currentIndex = 1
			else
				currentIndex = #list
			end

		end

	else

		currentIndex += direction

		if currentIndex > #list then
			currentIndex = 1
		elseif currentIndex < 1 then
			currentIndex = #list
		end

	end

	setTarget(list[currentIndex])
end

