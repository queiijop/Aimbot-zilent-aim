		--------------------------------------------------
		-- If accepted mode is active, immediately
		-- choose the next accepted player.
		--------------------------------------------------

		if acceptedMode then

			selectClosestAcceptedTarget()

		end

	end

	if targetMenu.Visible then
		refreshTargets()
	end

end)

